# Copy to .env (chmod 600) and adapt. EXAMPLE values.

# Address of Dolibarr allowed to use this office server, as the office server calls it, dots escaped:
#   https://dolibarr\.example\.com:443
CO_ALIASGROUP=https://dolibarr\.example\.com:443

# Local port where the reverse proxy reaches the container (127.0.0.1 only)
CO_PORT=9980
