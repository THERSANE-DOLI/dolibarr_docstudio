# Copy to .env and keep it private (chmod 600)

# Secret of the API of the document server: a long random string, for example the output of
#   openssl rand -hex 32
JWT_SECRET=

# Local port where the reverse proxy reaches the container (127.0.0.1 only)
EO_PORT=9982

# Size of a file at most, in bytes (100 MB)
EO_MAX_FILE_SIZE=104857600
